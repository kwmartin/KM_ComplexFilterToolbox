**/juliaFiles/
**/artifacts/
**/compiled/
**/packages/
**/environments/
**/conda/
**/scratchspaces/

# MATLAB editor autosave/backup droppings
*.asv
*~

# machine-specific MATLAB path caches - never portable, regenerate locally
/pathdef.m
/pathdef_.m
settings.mat

# personal scratch files that have repeatedly ended up committed by accident
/scatchsheet
/scatchsheet~
/worksheet.m~
/afile.mat
/filtOut.mat
/commit.msg
/history1.txt
/BackUp/
/tmp/

# tools/run_all_examples.sh output: point-in-time run artifacts, not source
/tools/reports/

# third-party reference PDFs (IEEE papers, textbook chapters, a thesis) -
# deliberately kept out of git (see Issues.md issue 2): copyrighted
# material, staged outside the repo at /home/Dropbox/Matlab/Complex/docs
# instead. Re-populated locally from time to time; never commit.
# Exception: snelgrove_cmplx.pdf - not copyrighted, author's permission
# obtained to make it available (2026-09-25). 1982_snelgrove_phd.pdf stays
# excluded.
/doc/*
!/doc/snelgrove_cmplx.pdf
# Exception: the description of the IEEE .tex generation flow (process only,
# no paper content; see MakePaper.md)
!/doc/make_tex_flow.md
# Exception: the public list of references that cannot be redistributed
# (built from doc/References.yaml by tools/make_references.py)
!/doc/References.yaml
!/doc/References.pdf

# The conference paper draft (see MakePaper.md) must not be public until
# after the conference: its source (doc/CmplxFltrGrpDly.md, already covered
# by /doc/* above), its figures (doc/figures/, also covered by /doc/*) and
# its rendered copies stay local (they live in Dropbox) and out of git.
/tools/build/

# Python bytecode caches (tools/*.py import each other)
__pycache__/
