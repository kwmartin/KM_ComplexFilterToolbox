    data = getData(rcrd, 256);
    outFile = strcat(jlDir, '/xinFile');
    save(outFile,'data');
    command = strcat(['julia ', jlDir, '/runFilt.jl']);
    [status,cmdout] = system(command);
    status
    inFile = strcat(jlDir, '/filtOut');
    strctin = load(inFile);
    xout = strctin.fltrOut;
    toc
    a = 1;