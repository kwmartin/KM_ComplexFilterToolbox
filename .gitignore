# MATLAB editor autosave/backup droppings
*.asv
*~

# machine-specific MATLAB path caches - never portable, regenerate locally
/pathdef.m
/pathdef_.m
settings.mat

# personal scratch files that have repeatedly ended up committed by accident
/scatchsheet
/scatchsheet~
/worksheet.m~
/afile.mat
/filtOut.mat
/commit.msg
/history1.txt
/BackUp/
/tmp/

# tools/run_all_examples.sh output: point-in-time run artifacts, not source
/tools/reports/

# third-party reference PDFs (IEEE papers, textbook chapters, a thesis) -
# deliberately kept out of git (see Issues.md issue 2): copyrighted
# material, staged outside the repo at /home/Dropbox/Matlab/Complex/docs
# instead. Re-populated locally from time to time; never commit.
# Exception: snelgrove_cmplx.pdf - not copyrighted, author's permission
# obtained to make it available (2026-09-25). 1982_snelgrove_phd.pdf stays
# excluded.
/doc/*
!/doc/snelgrove_cmplx.pdf
# Exception: the paper's own figures (examples/paper_figs_scld.m)
!/doc/figures/
